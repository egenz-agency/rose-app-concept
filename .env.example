# ═══════════════════════════════════════════════════════════════════════════
#  Environment variables — rose-app (multi-tenant branch)
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copy to .env.local for development:   cp .env.example .env.local
#
#  ⚠️  .env.local is GITIGNORED. Nothing in it reaches Vercel automatically.
#      Every variable below must ALSO be set in
#      Vercel → Project → Settings → Environment Variables.
#      That gap is the single most common cause of "works locally, broken in
#      production" on this project.
#
#  ⚠️  NEXT_PUBLIC_* variables are inlined at BUILD time, not read at runtime.
#      Adding or changing one in Vercel does nothing until you REDEPLOY.
#
#  Anything named NEXT_PUBLIC_* ships to the browser. Never put a secret there.
#
# ───────────────────────────────────────────────────────────────────────────
#  QUICK AUDIT — what breaks if each is missing
# ───────────────────────────────────────────────────────────────────────────
#  ROSE_SAAS_SERVICE_ROLE_KEY     every gift page and dashboard query fails
#  NEXT_PUBLIC_BASE_URL           Stripe sends paying customers to localhost
#  STRIPE_SECRET_KEY / PRICE_ID   checkout throws
#  STRIPE_WEBHOOK_SECRET          payment succeeds but the gift never activates
#  NEXT_PUBLIC_TURNSTILE_SITE_KEY no CAPTCHA widget → if Supabase CAPTCHA is ON,
#                                 NOBODY can sign in ("no captcha_token found")
# ═══════════════════════════════════════════════════════════════════════════


# ── Supabase: rose-saas (the multi-tenant product) ─────────────────────────
# This branch talks to the rose-saas project. Public values have safe built-in
# fallbacks in lib/supabase/roseSaasPublic.ts, so only the SECRET is mandatory.

# SECRET. Bypasses RLS entirely — server-only, never NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role
ROSE_SAAS_SERVICE_ROLE_KEY=

# Optional; falls back to the built-in project URL.
ROSE_SAAS_URL=

# Browser-safe publishable key + URL for buyer auth and RLS-scoped queries.
# Optional; both have fallbacks. Set BOTH or NEITHER.
NEXT_PUBLIC_ROSE_SAAS_URL=
NEXT_PUBLIC_ROSE_SAAS_ANON_KEY=


# ── Legacy single-tenant project (enchanted-rose) ──────────────────────────
# ⚠️  DEAD CODE. Only lib/supabase/queries.ts and /rosesecret read these, and
#     neither is reachable in the multi-tenant flow. Leave BLANK.
#     Setting both makes the browser client point at the OLD project — see
#     lib/supabase/client.ts, which switches only when both are present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── App URL ────────────────────────────────────────────────────────────────
# Used for Stripe success/cancel redirects and metadataBase.
#   local:      http://localhost:3000
#   production: https://rose-app-multitenant.vercel.app
# Falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL (Vercel sets those
# itself), but set it explicitly — the fallback yields the per-deploy preview
# URL, which is not where you want buyers landing after paying.
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# ── Stripe ─────────────────────────────────────────────────────────────────
# A gift is bought once and stays live for one year. No subscriptions.
#
# ⚠️  TEST AND LIVE MODE ARE SEPARATE WORLDS. The key, the price and the
#     webhook secret all have DIFFERENT values in live mode. Redo all three.

# Prefer a RESTRICTED key (rk_…) over a secret key (sk_…).
# Needs: Checkout Sessions (write), Customers (write), Invoices (write),
#        Prices (read).
# On Vercel mark it a *sensitive* environment variable.
STRIPE_SECRET_KEY=

# Must be a ONE-TIME price, not recurring, and needs a tax_behavior set on it.
# One env var per package — see lib/payments/plans.ts (`priceEnvVar`).
# Adding a tier = one entry there + one variable here.
STRIPE_PRICE_ID=

# whsec_… — DIFFERENT for the Stripe CLI and for the dashboard endpoint.
#   local:      stripe listen --forward-to localhost:3000/api/stripe/webhook
#   production: Dashboard → Webhooks → your endpoint → signing secret
# Without it, payments succeed and gifts never activate.
STRIPE_WEBHOOK_SECRET=

# VAT/GST. Leave "false" until your tax registrations show as *Collecting*.
# Turning it on before Stripe Tax setup is complete can break checkout outright,
# and even when on it collects NOTHING without an active registration.
STRIPE_AUTOMATIC_TAX=false


# ── Cloudflare Turnstile (CAPTCHA on the auth forms) ───────────────────────
# The site key is PUBLIC. The SECRET key goes in
# Supabase → Project Settings → Authentication → Bot and Abuse Protection.
#
# ⚠️  ORDER MATTERS — getting this backwards locks every account out:
#     1. set this variable, deploy, confirm the widget renders AND you can sign in
#     2. THEN enable CAPTCHA in Supabase
#     Reversing it means Supabase demands a token the app isn't sending.
#
# ⚠️  The Turnstile widget's allowed-domains list must include BOTH
#     `localhost` and your production domain, or the widget renders but
#     refuses to issue a token.
#
# Blank = CAPTCHA disabled client-side (safe default; never locks anyone out).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ── Optional tuning ────────────────────────────────────────────────────────

# Supabase's email OTP length (Authentication → Sign In/Providers → Email OTP
# Length), 6–10. Set this to match EXACTLY for the tightest sign-in UX.
# Left blank the field accepts 6–10 digits, which works whatever it's set to.
NEXT_PUBLIC_OTP_LENGTH=

# Service worker is disabled in development — it caches Next's dev chunks and
# causes stale-asset reload loops. Set true only to test PWA install or push
# notifications locally. Production always registers it.
NEXT_PUBLIC_ENABLE_SW=
